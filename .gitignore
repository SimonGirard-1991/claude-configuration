# Allowlist: every top-level entry is ignored unless un-ignored below, so the state
# Claude Code keeps adding beside the config stays out by default. To track something
# new at the top level, add its `!/` line (README.md's table then needs a row for it).
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/settings.json
!/.mcp.json
!/agents/
!/hooks/
!/rules/
!/scripts/
!/skills/

/skills/synced/
/skills/.trash/

.env*
*.token
.credentials.json

__pycache__/
*.py[cod]
*.log
logs/
mermaid-filter.err

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
