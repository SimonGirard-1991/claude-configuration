{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiPlugins": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(java -version)",
      "Bash(mvn --version)",
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn compile:*)",
      "Bash(mvn spotless:check:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew build:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.envrc)",
      "Read(**/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.envrc)",
      "Edit(**/.credentials.json)",
      "Bash(security find-generic-password:*)",
      "Bash(/usr/bin/security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(security export:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ],
    "ask": [
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-instructions.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-rules.sh java",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-rules.sh frontend",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/on-stop-validate.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/format-on-stop.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/sonar-gate-on-stop.sh",
            "timeout": 400
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(general-purpose|claude|learning-doc-writer|statusline-setup)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/on-stop-validate.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm/_cacache",
        "~/.npm/_logs"
      ],
      "denyRead": [
        "~/**/.env",
        "~/**/.env.local",
        "~/**/.env.*.local",
        "~/**/.envrc"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.kube/config",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "docker *",
      "gh *",
      "git push *",
      "git pull *",
      "git fetch *",
      "git clone *",
      "git ls-remote *",
      "ssh *",
      "scp *",
      "kubectl *",
      "mvn *",
      "./mvnw *",
      "./gradlew *",
      "gradle *",
      "~/.claude/scripts/sonar-gate.sh *"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "iterm2_with_bell",
  "agentPushNotifEnabled": true
}
